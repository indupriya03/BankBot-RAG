# ── DVC remote + MLflow tracking (DagsHub) ────────────────────────────────
DAGSHUB_TOKEN=your_dagshub_token_here
DAGSHUB_USERNAME=your_dagshub_username_here
# ── LLM generation (Groq — llama-3.3-70b-versatile) ──────────────────────
GROQ_API_KEY=your_groq_key_here

# ── Embeddings (Gemini — gemini-embedding-001, used by both build_vector_store.py
#    and retriever.py via gemini_embeddings.py) ───────────────────────────
GEMINI_API_KEY=your_gemini_key_here


# MLflow tracking URI on DagsHub — format: https://dagshub.com/<username>/<repo>.mlflow
MLFLOW_TRACKING_URI=https://dagshub.com/your_username/BankBot-RAG.mlflow

# ── Vector store location (used by retriever.py / build_vector_store.py) ─
CHROMA_PERSIST_DIR=data/vector_store/chroma_db

# ── HuggingFace offline mode (intent classifier: facebook/bart-large-mnli) ─
# Only enable AFTER the model has been downloaded/cached at least once
# (locally, or baked into the Docker image) — set 0 or leave unset for the
# first run / initial image build, then 1 for deployment to skip the
# huggingface.co version-check ping on every startup.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0